      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "\r",
                  "    pm.response.to.have.status(200)\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is below 2000 ms\", function() {\r",
                  "\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token is returned\", function() {\r",
                  "\r",
                  "   pm.expect(response.accessToken).not.be.undefined;\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\",response.accessToken);\r",
                  "\r",
                  "console.log(\"Access tokem saved successfully\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
