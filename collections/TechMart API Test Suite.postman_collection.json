      "item": [
        {
          "name": "Verify API Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = pm.response.json();\r",
                  "pm.test(\"Status code should be  200\", function() {\r",
                  "\r",
                  "    pm.response.to.have.status(200);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time should be less  than 2 seconds\", function(){\r",
                  "\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status should be ok\", function(){\r",
                  "\r",
                  "    pm.expect(response.status).to.eql(\"ok\");\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Method should be Get\", function() {\r",
                  "\r",
                  "    pm.expect(response.method).to.eql(\"GET\");\r",
                  "\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test",
              "host": [
                "{{base_url}}"
              ],
              "path": [
